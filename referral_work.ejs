<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main-content">
  <%- include('partials/topbar') %>
  <div class="stat-card mb-3">
    <h6>Your Referral Link</h6>
    <p class="text-muted small">Share this link — anyone who signs up through it automatically joins your team, at any depth.</p>
    <div class="input-group">
      <input type="text" class="form-control" id="refLink" readonly value="/signup?ref=<%= currentAssociate.referral_code %>">
      <button class="btn btn-outline-primary" onclick="navigator.clipboard.writeText(document.getElementById('refLink').value)">Copy</button>
    </div>
    <p class="mt-2 mb-0"><strong>Your Code:</strong> <%= currentAssociate.referral_code %></p>
    <script>
      document.getElementById('refLink').value = window.location.origin + '/signup?ref=<%= currentAssociate.referral_code %>';
    </script>
  </div>

  <div class="stat-card">
    <h6>Your Direct Referrals (<%= directs.length %>)</h6>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Joined</th></tr></thead>
        <tbody>
          <% directs.forEach(d => { %>
          <tr>
            <td><%= d.name %></td>
            <td><%= d.email %></td>
            <td><%= d.phone %></td>
            <td><span class="badge bg-<%= d.status==='active' ? 'success':'secondary' %>"><%= d.status %></span></td>
            <td><%= new Date(d.created_at).toLocaleDateString('en-IN') %></td>
          </tr>
          <% }) %>
          <% if (directs.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No direct referrals yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
