<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main-content">
  <%- include('partials/topbar') %>
  <div class="stat-card">
    <p class="text-muted">Flat list of your entire team (<%= rows.length %> members), across all levels.</p>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Level</th><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Joined</th></tr></thead>
        <tbody>
          <% rows.forEach(r => { %>
          <tr>
            <td><span class="badge bg-primary"><%= r.level %></span></td>
            <td><%= r.name %></td>
            <td><%= r.email %></td>
            <td><%= r.phone %></td>
            <td><span class="badge bg-<%= r.status==='active' ? 'success':'secondary' %>"><%= r.status %></span></td>
            <td><%= new Date(r.created_at).toLocaleDateString('en-IN') %></td>
          </tr>
          <% }) %>
          <% if (rows.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No team members yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
