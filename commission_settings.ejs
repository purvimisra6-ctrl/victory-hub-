<%- include('../partials/head') %>
<%- include('../partials/admin_sidebar') %>
<div class="main-content">
  <div class="topbar"><h5 class="mb-0">Commission Settings</h5></div>
  <div class="stat-card mb-3">
    <p class="text-muted small mb-2">Set the % commission for each level of the referral chain. Level 0 = the associate's own sale.
    Level 1 = their direct sponsor, Level 2 = sponsor's sponsor, and so on — you can add as many levels as your plan needs.
    Any level left unset pays 0%, which is where the payout chain naturally stops (the tree itself stays unlimited for reporting).</p>
    <form method="POST" action="/admin/commission-settings" class="row g-2">
      <div class="col-auto"><input type="number" min="0" class="form-control" name="level" placeholder="Level" required></div>
      <div class="col-auto"><input type="number" step="0.01" min="0" max="100" class="form-control" name="percentage" placeholder="Percentage" required></div>
      <div class="col-auto"><button class="btn btn-primary">Save</button></div>
    </form>
  </div>
  <div class="stat-card">
    <table class="table">
      <thead><tr><th>Level</th><th>Percentage</th></tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr><td><%= r.level === 0 ? 'Level 0 (Own Sale)' : ('Level ' + r.level) %></td><td><%= r.percentage %>%</td></tr>
        <% }) %>
        <% if (rows.length === 0) { %><tr><td colspan="2" class="text-center text-muted py-3">No commission levels configured yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
