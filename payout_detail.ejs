<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main-content">
  <%- include('partials/topbar') %>
  <div class="stat-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Date</th><th>Customer</th><th>Project / Plot</th><th>Level</th><th>%</th><th>Amount</th><th>Status</th></tr></thead>
        <tbody>
          <% payouts.forEach(p => { %>
          <tr>
            <td><%= new Date(p.created_at).toLocaleDateString('en-IN') %></td>
            <td><%= p.customer_name %></td>
            <td><%= p.project_name || '-' %> / <%= p.plot_no || '-' %></td>
            <td><%= p.level === 0 ? 'Own Sale' : ('Level ' + p.level) %></td>
            <td><%= p.percentage_applied %>%</td>
            <td>₹<%= Number(p.amount).toLocaleString('en-IN') %></td>
            <td><span class="badge bg-<%= p.status==='paid' ? 'success' : (p.status==='approved' ? 'info' : 'warning') %>"><%= p.status %></span></td>
          </tr>
          <% }) %>
          <% if (payouts.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No payouts yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
