<div class="sidebar">
  <div class="brand"><i class="bi bi-shield-lock-fill"></i> Admin - <%= companyName %></div>
  <div class="pt-2">
    <a href="/admin" class="<%= activeAdminPage==='overview' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Overview</a>
    <a href="/admin/associates" class="<%= activeAdminPage==='associates' ? 'active' : '' %>"><i class="bi bi-people"></i> Associates</a>
    <a href="/admin/bookings" class="<%= activeAdminPage==='bookings' ? 'active' : '' %>"><i class="bi bi-journal-plus"></i> Bookings</a>
