<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main-content">
  <%- include('partials/topbar') %>
  <div class="stat-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Project</th><th>Plot No</th><th>Sq/Ft</th><th>Status</th></tr></thead>
        <tbody>
          <% plots.forEach(p => { %>
          <tr>
            <td><%= p.project_name %></td>
            <td><%= p.plot_no %></td>
            <td><%= p.sqft ? Number(p.sqft).toLocaleString() : '-' %></td>
            <td><span class="badge bg-<%= p.status==='available' ? 'success' : (p.status==='sold' ? 'dark' : 'warning') %>"><%= p.status %></span></td>
          </tr>
          <% }) %>
          <% if (plots.length === 0) { %>
          <tr><td colspan="4" class="text-center text-muted py-4">No plot inventory added yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
