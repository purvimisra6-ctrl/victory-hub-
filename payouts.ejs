<%- include('../partials/head') %>
<%- include('../partials/admin_sidebar') %>
<div class="main-content">
  <div class="topbar"><h5 class="mb-0">Payouts</h5>
    <a href="/admin/payments/new" class="btn btn-secondary btn-sm"><i class="bi bi-cash"></i> Record Payment</a>
  </div>
  <div class="stat-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Date</th><th>Associate</th><th>Level</th><th>%</th><th>Amount</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% rows.forEach(p => { %>
          <tr>
            <td><%= new Date(p.created_at).toLocaleDateString('en-IN') %></td>
            <td><%= p.associate_name %></td>
            <td><%= p.level === 0 ? 'Own Sale' : ('Level ' + p.level) %></td>
            <td><%= p.percentage_applied %>%</td>
            <td>₹<%= Number(p.amount).toLocaleString('en-IN') %></td>
            <td><span class="badge bg-<%= p.status==='paid' ? 'success' : (p.status==='approved' ? 'info' : 'warning') %>"><%= p.status %></span></td>
            <td>
              <form method="POST" action="/admin/payouts/<%= p.id %>/status" class="d-flex gap-1">
                <select name="status" class="form-select form-select-sm" style="width:auto">
                  <option value="pending" <%= p.status==='pending'?'selected':'' %>>Pending</option>
                  <option value="approved" <%= p.status==='approved'?'selected':'' %>>Approved</option>
                  <option value="paid" <%= p.status==='paid'?'selected':'' %>>Paid</option>
                </select>
                <button class="btn btn-sm btn-outline-primary">Update</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
