<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="main-content">
  <%- include('partials/topbar') %>
  <div class="stat-card">
    <p class="text-muted">Commission you earned from your <strong>team's</strong> sales (unlimited levels down your referral chain).</p>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Date</th><th>Earned From</th><th>Level</th><th>%</th><th>Amount</th><th>Status</th></tr></thead>
        <tbody>
          <% payouts.forEach(p => { %>
          <tr>
            <td><%= new Date(p.created_at).toLocaleDateString('en-IN') %></td>
            <td><%= p.source_name %></td>
            <td>Level <%= p.level %></td>
            <td><%= p.percentage_applied %>%</td>
            <td>₹<%= Number(p.amount).toLocaleString('en-IN') %></td>
            <td><span class="badge bg-<%= p.status==='paid' ? 'success' : (p.status==='approved' ? 'info' : 'warning') %>"><%= p.status %></span></td>
          </tr>
          <% }) %>
          <% if (payouts.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No team payouts yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
