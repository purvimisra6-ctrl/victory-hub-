<%- include('../partials/head') %>
<%- include('../partials/admin_sidebar') %>
<div class="main-content">
  <div class="topbar"><h5 class="mb-0">Bookings</h5>
    <a href="/admin/bookings/new" class="btn btn-success btn-sm"><i class="bi bi-plus-circle"></i> Add Booking</a>
  </div>
  <div class="stat-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Date</th><th>Associate</th><th>Customer</th><th>Project/Plot</th><th>Sq/Ft</th><th>Amount</th><th>Status</th></tr></thead>
        <tbody>
          <% rows.forEach(b => { %>
          <tr>
            <td><%= new Date(b.booking_date).toLocaleDateString('en-IN') %></td>
            <td><%= b.associate_name %></td>
            <td><%= b.customer_name %></td>
            <td><%= b.project_name || '-' %> / <%= b.plot_no || '-' %></td>
            <td><%= Number(b.sqft).toLocaleString() %></td>
            <td>₹<%= Number(b.amount).toLocaleString('en-IN') %></td>
            <td><span class="badge bg-<%= b.status==='confirmed' ? 'success' : (b.status==='cancelled' ? 'danger' : 'warning') %>"><%= b.status %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
